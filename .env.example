# Copy to .env and adjust if needed. All values below are the framework's defaults.
API_BASE_URL=http://localhost:3000/v1
REQUEST_TIMEOUT_SECONDS=10

# Order polling (server transitions: PENDING->PROCESSING at 5s, PROCESSING->COMPLETED at 15s)
ORDER_POLL_INTERVAL_SECONDS=1
ORDER_POLL_TIMEOUT_SECONDS=25

# Export polling (server transitions: PROCESSING->COMPLETED at 60s)
EXPORT_POLL_INTERVAL_SECONDS=2
EXPORT_POLL_TIMEOUT_SECONDS=75
